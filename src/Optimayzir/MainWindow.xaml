<Window x:Class="Optimayzir.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optimayzır" Width="1080" Height="720" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ShortcutButton" Content="Masaüstü kısayolu oluştur" Style="{StaticResource GhostButton}"
                        Margin="0,0,8,0" Click="ShortcutButton_Click" />
                <Button x:Name="RefreshButton" Content="Yeniden analiz et" Style="{StaticResource GhostButton}"
                        Click="RefreshButton_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/app.ico" Width="42" Height="42" Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Optimayzır" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="Gereksiz dosyaları güvenle temizler, RAM'i yiyen programları gösterir."
                               Style="{StaticResource Caption}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Sistem durumu kartları -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,20,0,0">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="RAM" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="RamText" Style="{StaticResource CardValue}" />
                    <ProgressBar x:Name="RamBar" Style="{StaticResource Bar}" />
                    <TextBlock x:Name="RamSub" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Disk" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="DiskText" Style="{StaticResource CardValue}" />
                    <ProgressBar x:Name="DiskBar" Style="{StaticResource Bar}" />
                    <TextBlock x:Name="DiskSub" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Açık kalma süresi" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="UptimeText" Style="{StaticResource CardValue}" />
                    <TextBlock Text="son yeniden başlatmadan beri" Style="{StaticResource Caption}" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Başlangıç programları" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="StartupText" Style="{StaticResource CardValue}" />
                    <TextBlock Text="Windows açılırken çalışan" Style="{StaticResource Caption}" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Öneriler -->
        <Border x:Name="TipsBorder" Grid.Row="2" Margin="0,12,0,0" Padding="14,10" CornerRadius="10"
                Background="#1F1A10" BorderBrush="#4A3A12" BorderThickness="1" Visibility="Collapsed">
            <ItemsControl x:Name="TipsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat='•  {0}'}" Foreground="{StaticResource Warn}"
                                   FontSize="12.5" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Görevler ve işlemler -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Temizlik görevleri" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Top" Text="İşaretli olanlar tek tıkla çalışır."
                               Style="{StaticResource Caption}" Margin="0,2,0,6" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TasksList" Margin="0,0,12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Padding="0,11" BorderBrush="{StaticResource CardBorder}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsAvailable}"
                                                      VerticalAlignment="Top" Margin="0,3,12,0" />
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#1F2430" CornerRadius="5" Padding="6,1"
                                                            Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" FontSize="10"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                           Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource OptionalLine}"
                                                           Foreground="{StaticResource Warn}" />
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource OptionalLine}"
                                                           Foreground="{StaticResource Good}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Estimate}" FontSize="14"
                                                       FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Top" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                            <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="En çok RAM kullananlar" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Top" Text="Kullanmadığınız bir programı kapatmak, RAM'ini hemen boşaltır."
                               Style="{StaticResource Caption}" Margin="0,2,0,6" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ProcList" Margin="0,0,12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,8" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding MemoryText}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="10,0" />
                                            <Button Grid.Column="2" Content="Kapat" Style="{StaticResource GhostButton}"
                                                    Tag="{Binding}" Click="CloseProcess_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Alt bar -->
        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="SummaryText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Good}"
                           Style="{StaticResource OptionalLine}" />
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>
            <Button x:Name="OptimizeButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                    Content="⚡  Tek Tıkla Optimize Et" Click="OptimizeButton_Click" />
        </Grid>
    </Grid>
</Window>
