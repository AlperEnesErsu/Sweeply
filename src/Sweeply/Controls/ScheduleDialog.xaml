<Window x:Class="Sweeply.Controls.ScheduleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="560" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display">
    <!-- Kenar boşluğu gölgenin taşabilmesi için -->
    <Border x:Name="Panel" Margin="24" Padding="24,22,20,18" CornerRadius="12"
            Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="PanelScale" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" FontSize="13" Margin="0,6,0,0" LineHeight="19" />

            <TextBlock Text="Gün" Style="{StaticResource Caption}" Margin="0,18,0,8" />
            <WrapPanel x:Name="Days" />

            <TextBlock Text="Saat" Style="{StaticResource Caption}" Margin="0,10,0,8" />
            <WrapPanel x:Name="Times" />

            <TextBlock Text="Çalışacak görevler" Style="{StaticResource Caption}" Margin="0,10,0,6" />
            <TextBlock x:Name="TasksText" TextWrapping="Wrap" LineHeight="19" />
            <TextBlock x:Name="WarningText" Style="{StaticResource Caption}" Foreground="{StaticResource Warn}"
                       Margin="0,10,0,0" LineHeight="19" />

            <DockPanel Margin="0,22,0,0">
                <Button x:Name="RemoveButton" DockPanel.Dock="Left" Style="{StaticResource TextButton}" Padding="12,8" FontSize="13"
                        Content="Otomatik temizliği kapat" Visibility="Collapsed" Click="Remove_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TextButton}" Padding="16,8" Margin="0,0,8,0" FontSize="13"
                            Content="Vazgeç" IsCancel="True" Click="Cancel_Click" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Padding="18,9" FontSize="13"
                            IsDefault="True" Click="Confirm_Click" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
