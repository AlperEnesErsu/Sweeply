<Window x:Class="Sweeply.Controls.ListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Width="720" Height="560" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display">
    <Border x:Name="Panel" Margin="24" CornerRadius="12" Background="{StaticResource Raised}"
            BorderBrush="{StaticResource Line}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="PanelScale" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <DockPanel>
            <!-- Başlık -->
            <Border DockPanel.Dock="Top" Padding="24,20,16,16" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                    Background="Transparent" x:Name="Header">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Padding="8" VerticalAlignment="Top"
                            IsCancel="True" Click="Close_Click" AutomationProperties.Name="Kapat">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" />
                    </Button>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Alt çubuk -->
            <Border DockPanel.Dock="Bottom" Padding="24,12,20,14" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Button x:Name="ActionButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="16,8"
                            FontSize="13" Visibility="Collapsed" Click="Action_Click" />
                    <TextBlock x:Name="FooterText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Satırlar -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,6,12,6">
                <ItemsControl x:Name="Rows" Margin="0,0,12,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" Padding="0,8" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="Primary" Text="{Binding Primary}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Primary}" />
                                        <TextBlock Text="{Binding Secondary}" Style="{StaticResource OptionalLine}"
                                                   Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <TextBlock x:Name="Right" Grid.Column="1" Text="{Binding Right}" Margin="16,0,0,0"
                                               Typography.NumeralAlignment="Tabular" VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                    <Setter TargetName="Row" Property="Padding" Value="0,18,0,8" />
                                    <Setter TargetName="Primary" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="Right" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
