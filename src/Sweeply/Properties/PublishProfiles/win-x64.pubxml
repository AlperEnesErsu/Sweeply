<?xml version="1.0" encoding="utf-8"?>
<!--
  .NET kurulu olmayan bilgisayarlarda da çalışan tek bir Sweeply.exe üretir.
  Kullanım: dotnet publish src/Sweeply/Sweeply.csproj -p:PublishProfile=win-x64
  (Bu ayarlar proje dosyasında değil burada, çünkü test projesi uygulamaya referans veriyor ve
  self-contained bir exe'ye referans veren test projesi derlenemez.)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF'in yerel DLL'leri (wpfgfx, PresentationNative…) de exe'nin içine gömülür. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
